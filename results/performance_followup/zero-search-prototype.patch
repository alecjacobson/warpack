diff --git a/warpack/block_products.py b/warpack/block_products.py
index ce29675..3de1873 100644
--- a/warpack/block_products.py
+++ b/warpack/block_products.py
@@ -111,3 +111,53 @@ def paired_ritz_rotation(
         wp.tile_matmul(a, b, acc_u)
     wp.tile_store(x, acc_x + acc_u, offset=(i * 4, j * 32))
     wp.tile_store(p, acc_u, offset=(i * 4, j * 32))
+
+
+@functools.lru_cache(None)
+def prefix_gram_kernel(chunk, symmetric):
+    """Gram with a known nonzero row prefix; caller clears the output.
+
+    Both inputs have zero rows at and beyond rank[0], as produced by metric
+    whitening. Rank is read on device; no extra truncation decision is made.
+    """
+    blocks = wp.constant(chunk // 32)
+    stride = wp.constant(chunk)
+    triangle = wp.constant(symmetric)
+
+    @wp.kernel(enable_backward=False, module="unique")
+    def compute(
+        x: wp.array2d[wp.float64],
+        y: wp.array2d[wp.float64],
+        g: wp.array2d[wp.float64],
+        rank: wp.array[wp.int32],
+    ):
+        i, j, piece = wp.tid()
+        if i * 8 < rank[0] and j * 8 < rank[0] and (not triangle or i <= j):
+            acc = wp.tile_zeros(shape=(8, 8), dtype=wp.float64)
+            for k in range(blocks):
+                a = wp.tile_load(x, shape=(8, 32), offset=(i * 8, piece * stride + k * 32))
+                b = wp.tile_load(y, shape=(8, 32), offset=(j * 8, piece * stride + k * 32))
+                wp.tile_matmul(a, wp.tile_transpose(b), acc)
+            wp.tile_atomic_add(g, acc, offset=(i * 8, j * 8))
+            if triangle and i != j:
+                wp.tile_atomic_add(g, wp.tile_transpose(acc), offset=(j * 8, i * 8))
+
+    return compute
+
+
+@wp.kernel
+def rotate_prefix(
+    q: wp.array2d[wp.float64],
+    coeff: wp.array2d[wp.float64],
+    out: wp.array2d[wp.float64],
+    rank: wp.array[wp.int32],
+):
+    # Whitening writes zero coefficient rows outside the retained prefix.
+    i, j = wp.tid()
+    acc = wp.tile_zeros(shape=(4, 32), dtype=wp.float64)
+    if i * 4 < rank[0]:
+        for block in range((q.shape[0] + 7) // 8):
+            a = wp.tile_load(coeff, shape=(4, 8), offset=(i * 4, block * 8))
+            b = wp.tile_load(q, shape=(8, 32), offset=(block * 8, j * 32))
+            wp.tile_matmul(a, b, acc)
+    wp.tile_store(out, acc, offset=(i * 4, j * 32))
diff --git a/tests/test_block_prefix_products.py b/tests/test_block_prefix_products.py
new file mode 100644
index 0000000..57819e3
--- /dev/null
+++ b/tests/test_block_prefix_products.py
@@ -0,0 +1,63 @@
+"""Skip only rows already known to be zero, retaining every partial tile."""
+
+import numpy as np
+import pytest
+import warp as wp
+
+from warpack.block import gram
+from warpack.block_products import rotate_prefix
+
+
+@pytest.mark.parametrize("symmetric", [False, True])
+@pytest.mark.parametrize("chunk", [256, 1024])
+def test_prefix_gram_changed_rank_and_coefficients(symmetric, chunk):
+    rng = np.random.default_rng(927)
+    x = wp.zeros((20, 513), dtype=wp.float64)
+    y = wp.zeros_like(x)
+    result = wp.empty((20, 20), dtype=wp.float64)
+    rank = wp.zeros(1, dtype=wp.int32)
+    gram(x, y, result, chunk=chunk, symmetric=symmetric, active_rank=rank)
+    wp.synchronize()
+    with wp.ScopedCapture() as capture:
+        gram(x, y, result, chunk=chunk, symmetric=symmetric, active_rank=rank)
+    for active in (0, 1, 9, 20, 7, 0, 17):
+        source = rng.normal(size=x.shape)
+        source[active:] = 0
+        image = source * np.linspace(1, 2, source.shape[1])
+        x.assign(source)
+        y.assign(image)
+        rank.fill_(active)
+        result.fill_(float("nan"))
+        wp.capture_launch(capture.graph)
+        actual = result.numpy()
+        np.testing.assert_allclose(actual, source @ image.T, rtol=2e-13, atol=1e-11)
+        np.testing.assert_array_equal(actual[active:], 0)
+        np.testing.assert_array_equal(actual[:, active:], 0)
+
+
+def test_prefix_rotation_partial_output_inner_and_column_tiles():
+    rng = np.random.default_rng(971)
+    x = wp.array(rng.normal(size=(19, 137)), dtype=wp.float64)
+    coeff = wp.zeros((13, 19), dtype=wp.float64)
+    result = wp.empty((13, 137), dtype=wp.float64)
+    rank = wp.zeros(1, dtype=wp.int32)
+
+    def run():
+        wp.launch_tiled(rotate_prefix, dim=(4, 5), inputs=[x, coeff, result, rank], block_dim=128)
+
+    run()
+    wp.synchronize()
+    with wp.ScopedCapture() as capture:
+        run()
+    for active in (0, 1, 3, 7, 13, 4, 0):
+        source = rng.normal(size=x.shape)
+        transform = rng.normal(size=coeff.shape)
+        transform[active:] = 0
+        x.assign(source)
+        coeff.assign(transform)
+        rank.fill_(active)
+        result.fill_(float("nan"))
+        wp.capture_launch(capture.graph)
+        actual = result.numpy()
+        np.testing.assert_allclose(actual, transform @ source, rtol=2e-13, atol=1e-12)
+        np.testing.assert_array_equal(actual[active:], 0)
